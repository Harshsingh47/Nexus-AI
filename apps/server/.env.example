# ==============================================================================
# NEXUSMIND AI - ENTERPRISE PLATFORM ENVIRONMENT VARIABLES & API KEYS
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=nexusmind_jwt_secret_key_change_in_prod_2026

# Database & Cache (PostgreSQL + pgvector & Redis)
DATABASE_URL="postgresql://nexusmind:nexusmind_password_2026@localhost:5432/nexusmind_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER API KEYS (Provide at least ONE or use local Ollama / mock)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."
GROQ_API_KEY="gsk_..."
MISTRAL_API_KEY="..."
COHERE_API_KEY="..."
XAI_API_KEY="..."
AZURE_OPENAI_API_KEY="..."
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
OPENROUTER_API_KEY="sk-or-..."

# Local Models (No API Key Required)
OLLAMA_BASE_URL="http://localhost:11434"
LM_STUDIO_BASE_URL="http://localhost:1234/v1"

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE API KEYS (Optional if using default pgvector)
# ------------------------------------------------------------------------------
PINECONE_API_KEY="..."
PINECONE_ENVIRONMENT="us-east-1"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="..."

# ------------------------------------------------------------------------------
# 3. BILLING & PAYMENTS (Stripe Integration)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 4. STORAGE (S3 Compatible Storage / MinIO)
# ------------------------------------------------------------------------------
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_NAME="nexusmind-documents"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & GOOGLE OAUTH2
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
